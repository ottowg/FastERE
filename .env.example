# FastERE environment variables
# Copy this file to .env and fill in your paths.
# These are read by EnvSettings (pydantic-settings) at runtime.

# Root directory where datasets are stored.
DATASET_DIR=/path/to/your/datasets

# Where training outputs (checkpoints, logs) are written.
OUTPUT_DIR=output

# Cache directory for preprocessed tensor files.
CACHE_DIR=.cache

# Weights & Biases project name.
WANDB_PROJECT=fastere
